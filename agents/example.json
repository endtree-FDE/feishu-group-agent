    "dir": "memory",
    "profile_budget_chars": 1500,
    "max_fact_chars": 300,
    "scope": "topic",
    "max_turns": 6,
    "ttl_hours": 24,
    "per_user": false
  },
  "skills": {
    "enabled": false,
