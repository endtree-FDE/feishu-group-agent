{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "agents/config.schema.json",
  "title": "飞书群智能体配置",
  "description": "缺了的键保持旧行为。不认识的键先留着，不因此判失败。密钥不要写进这个文件。",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "base_dir": {
      "type": "string"
    },
    "kb_dir": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "bot_open_id": {
      "type": "string"
    },
    "bot_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "chat_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reply_in_thread": {
      "type": "boolean"
    },
    "max_concurrency": {
      "type": "integer",
      "minimum": 1
    },
    "max_queue": {
      "type": "integer",
      "minimum": 0
    },
    "model_provider": {
      "type": "string",
      "enum": [
        "cursor",
        "openai_compat",
        "fake",
        "deepseek",
        "dashscope",
        "zhipu",
        "pangu"
      ]
    },
    "dry_run_live_reads": {
      "type": "boolean"
    },
    "redact_file": {
      "type": "string"
    },
    "help_pattern": {
      "type": "string"
    },
    "system_prompt": {
      "type": "string"
    },
    "kb_index": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "budget_chars": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "chats": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "auto_join": {
          "type": "boolean"
        },
        "admit": {
          "type": "string"
        },
        "inviter_open_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "catchup": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "overlap_sec": {
          "type": "integer",
          "minimum": 0
        },
        "max_messages": {
          "type": "integer",
          "minimum": 0
        },
        "max_age_sec": {
          "type": "integer",
          "minimum": 0,
          "description": "补答最多回溯多少秒。不写是 43200。0 表示不再另加时限。"
        }
      }
    },
    "thread_followup": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "who": {
          "type": "string"
        }
      }
    },
    "rate_limit": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "min_gap_per_user": {
          "type": "number",
          "minimum": 0
        },
        "max_per_hour": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "status": {
          "type": "boolean",
          "description": "不写或 true 时，/状态、/status 或单独一个「状态」不调用模型。false 时这几个字仍交给模型。"
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "journal": {
          "type": "boolean"
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "memory": {
          "type": "boolean"
        },
        "p2p": {
          "type": "boolean"
        },
        "tools": {
          "type": "boolean"
        },
        "attachments": {
          "type": "boolean"
        },
        "vision": {
          "type": "boolean"
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "dir": {
          "type": "string"
        },
        "profile_budget_chars": {
          "type": "integer",
          "minimum": 0
        },
        "recall": {
          "type": "boolean"
        },
        "recall_budget_chars": {
          "type": "integer",
          "minimum": 0
        },
        "max_fact_chars": {
          "type": "integer",
          "minimum": 0
        },
        "scope": {
          "type": "string"
        },
        "max_turns": {
          "type": "integer",
          "minimum": 0
        },
        "max_turn_chars": {
          "type": "integer",
          "minimum": 0,
          "description": "记进短期记忆的一条最多多少字，只留开头。不写是 2000。0 表示整段都留。"
        },
        "context_budget_chars": {
          "type": "integer",
          "minimum": 0
        },
        "ttl_hours": {
          "type": "number",
          "minimum": 0
        },
        "per_user": {
          "type": "boolean"
        },
        "trim_note": {
          "type": "boolean",
          "description": "不写或 true：超字数预算丢掉旧对话时，在提示词里注明省略了几条。false 则静默丢掉。"
        }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "dir": {
          "type": "string"
        },
        "only": {
          "description": "不写、空数组或 false：合法技能全部选用。字符串或字符串数组才收窄目录、预放和 skill_read。创作流程可点名 topic-ideation、short-video-script、storyboard、aigc-prompt-pack、creative-brief、post-mortem。example.json 里仍是空数组。",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "boolean"
            },
            {
              "type": "string"
            }
          ]
        },
        "index_budget_chars": {
          "type": "integer",
          "minimum": 0
        },
        "preload": {
          "type": "boolean"
        },
        "preload_budget_chars": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "p2p": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "allow_open_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_to_all": {
          "type": "boolean"
        },
        "allow_group_members": {
          "type": "boolean",
          "description": "为 true 时，所服务群的当前成员可以私聊。不写或 false 时不查群成员。"
        },
        "member_cache_ttl_sec": {
          "type": "integer",
          "minimum": 0,
          "description": "群成员名单缓存秒数。不写是 600。失败时上次成功的名单最多再沿用两倍。"
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "mode": {
          "type": "string"
        },
        "preset": {
          "type": "string",
          "enum": [
            "",
            "deepseek",
            "dashscope",
            "zhipu",
            "pangu"
          ]
        },
        "model": {
          "type": "string"
        },
        "base_url": {
          "type": "string",
          "pattern": "^$|^https?://\\S+$"
        },
        "api_key_env": {
          "type": "string",
          "pattern": "^$|^[A-Za-z_][A-Za-z0-9_]{0,80}$"
        },
        "network_retries": {
          "type": "integer",
          "minimum": 0
        },
        "max_runtime_sec": {
          "type": "number",
          "minimum": 0
        },
        "stall_sec": {
          "type": "number",
          "minimum": 0
        },
        "max_chars": {
          "type": "integer",
          "minimum": 0
        },
        "body_max_chars": {
          "type": "integer",
          "minimum": 0
        },
        "reply_chunk_chars": {
          "type": "integer",
          "minimum": 0
        },
        "max_tool_rounds": {
          "type": "integer",
          "minimum": 0,
          "description": "只读工具最多连续几轮。不写是 4。小于 1 时按 1。每一轮可以按顺序执行多条只读调用。"
        },
        "tool_context_budget_chars": {
          "type": "integer",
          "minimum": 0,
          "description": "多轮工具结果累积重发的字数预算。不写是 120000。超过时先压缩较早的结果，仍超就截断并注明。0 表示不设预算。"
        },
        "progress_heartbeat_sec": {
          "type": "number",
          "minimum": 0,
          "description": "作答时隔多少秒记进度心跳。不写是 20。0 表示不打这条心跳。"
        }
      }
    },
    "texts": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "redlines": {
          "type": "array"
        }
      }
    },
    "kb_sync": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "docs_tokens": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "write": {
      "type": "object",
      "additionalProperties": true
    },
    "progress": {
      "type": "object",
      "additionalProperties": true
    },
    "tools": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "history": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "days": {
              "type": "integer",
              "minimum": 0
            },
            "max_pages": {
              "type": "integer",
              "minimum": 0
            },
            "page_size": {
              "type": "integer",
              "minimum": 1,
              "description": "拉群消息时每页条数。不写是 50。停机补答也用这个数。"
            },
            "max_lines": {
              "type": "integer",
              "minimum": 0,
              "description": "交给模型的历史最多几行。不写是 150。超过时注明还剩几行。0 表示不截断。"
            }
          }
        },
        "docs_search": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "max_chars": {
              "type": "integer",
              "minimum": 0,
              "description": "搜索结果最多多少字。不写是 4000。0 表示不截断。"
            }
          }
        },
        "calendar_read": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "max_chars": {
              "type": "integer",
              "minimum": 0,
              "description": "日程结果最多多少字。不写是 4000。0 表示不截断。"
            }
          }
        },
        "base_read": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "max_chars": {
              "type": "integer",
              "minimum": 0,
              "description": "表格结果最多多少字。不写是 5000。0 表示不截断。"
            }
          }
        },
        "message_attachment": {
          "type": "object",
          "additionalProperties": true,
          "description": "读取当前会话里某条历史消息的附件。没写时跟着 attachment.enabled。",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "max_per_answer": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "kb_read": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "max_chars": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "attachment": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "pdf_scan_pages": {
              "type": "integer",
              "minimum": 0,
              "description": "PDF 没有文字时，最多抽出前几页里的内嵌图片。不写是 10。"
            }
          }
        }
      }
    },
    "conflict_pidfiles": {
      "type": "array"
    },
    "shutdown_wait_sec": {
      "type": "number",
      "minimum": 0,
      "description": "停机最多再等几秒。不写是 15。0 表示马上退出。"
    },
    "link_jump_sec": {
      "type": "number",
      "minimum": 0,
      "description": "休眠超过这么多秒就重连长连接。不写是 20。0 表示不因为休眠重连。"
    }
  }
}
