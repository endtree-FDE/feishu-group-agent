{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "agents/config.schema.json",
  "title": "飞书群智能体配置",
  "description": "缺了的键保持旧行为。不认识的键先留着，不因此判失败。密钥不要写进这个文件。",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "base_dir": {
      "type": "string"
    },
    "kb_dir": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "bot_open_id": {
      "type": "string"
    },
    "bot_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "chat_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reply_in_thread": {
      "type": "boolean"
    },
    "max_concurrency": {
      "type": "integer",
      "minimum": 1
    },
    "max_queue": {
      "type": "integer",
      "minimum": 0
    },
    "model_provider": {
      "type": "string",
      "enum": [
        "cursor",
        "openai_compat",
        "openai_compatible",
        "anthropic",
        "claude",
        "fake",
        "deepseek",
        "dashscope",
        "zhipu",
        "pangu"
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": true,
      "description": "可替换的模型。不写时仍用 model_provider，没写就是 cursor。密钥只写环境变量名。",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "",
            "cursor",
            "openai_compat",
            "openai_compatible",
            "anthropic",
            "claude",
            "fake",
            "deepseek",
            "dashscope",
            "zhipu",
            "pangu"
          ]
        },
        "preset": {
          "type": "string",
          "enum": ["", "deepseek", "dashscope", "zhipu", "pangu"]
        },
        "base_url": {
          "type": "string",
          "pattern": "^$|^https?://\\S+$"
        },
        "model": {
          "type": "string"
        },
        "api_key_env": {
          "type": "string",
          "pattern": "^$|^[A-Za-z_][A-Za-z0-9_]{0,80}$"
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "timeout_sec": {
          "type": "number",
          "minimum": 0
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": true,
      "description": "可选网页搜索。不写或 enabled 为 false 时不调用。",
      "properties": {
        "enabled": {"type": "boolean"},
        "backend": {
          "type": "string",
          "enum": ["", "tavily", "searxng", "searx"]
        },
        "base_url": {"type": "string"},
        "api_key_env": {
          "type": "string",
          "pattern": "^$|^[A-Za-z_][A-Za-z0-9_]{0,80}$"
        },
        "timeout_sec": {"type": "number", "minimum": 0},
        "max_results": {"type": "integer", "minimum": 1}
      }
    },
    "dry_run_live_reads": {
      "type": "boolean"
    },
    "redact_file": {
      "type": "string"
    },
    "help_pattern": {
      "type": "string"
    },
    "system_prompt": {
      "type": "string"
    },
    "kb_index": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "budget_chars": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "chats": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "auto_join": {
          "type": "boolean"
        },
        "admit": {
          "type": "string"
        },
        "inviter_open_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "catchup": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "overlap_sec": {
          "type": "integer",
          "minimum": 0
        },
        "max_messages": {
          "type": "integer",
          "minimum": 0
        },
        "max_age_sec": {
          "type": "integer",
          "minimum": 0,
          "description": "补答最多回溯多少秒。不写是 43200。0 表示不再另加时限。"
        }
      }
    },
    "thread_followup": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "who": {
          "type": "string"
        }
      }
    },
    "rate_limit": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "min_gap_per_user": {
          "type": "number",
          "minimum": 0
        },
        "max_per_hour": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "status": {
          "type": "boolean",
          "description": "不写或 true 时，/状态、/status 或单独一个「状态」不调用模型。false 时这几个字仍交给模型。"
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "journal": {
          "type": "boolean"
        },
        "calls": {
          "description": "不写或 enabled 不为 false 时，每轮回答在 logs/calls.jsonl 记一条已脱敏的调用链。false 表示不记。",
          "oneOf": [
            {"type": "boolean"},
            {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "enabled": {"type": "boolean"},
                "retain_days": {"type": "integer", "minimum": 1}
              }
            }
          ]
        }
      }
    },
    "alerts": {
      "type": "object",
      "additionalProperties": true,
      "description": "长连接或心跳不健康时通知主人。不写或 enabled 为 false 时不发消息。",
      "properties": {
        "enabled": {"type": "boolean"},
        "owner_open_ids": {"type": "array", "items": {"type": "string"}},
        "unhealthy_after_sec": {"type": "number", "minimum": 0},
        "repeat_sec": {"type": "number", "minimum": 0},
        "local_log": {"type": "boolean"},
        "windows_toast": {"type": "boolean"}
      }
    },
    "digest": {
      "type": "object",
      "additionalProperties": true,
      "description": "到点往指定群发一条今日摘要。不写或 enabled 为 false 时不发。",
      "properties": {
        "enabled": {"type": "boolean"},
        "time": {"type": "string"},
        "timezone": {"type": "string"},
        "chat_ids": {"type": "array", "items": {"type": "string"}},
        "window_min": {"type": "integer", "minimum": 0},
        "include_calendar": {"type": "boolean"},
        "include_tasks": {"type": "boolean"},
        "status_field": {"type": "string"},
        "title_field": {"type": "string"},
        "done_values": {"type": "array", "items": {"type": "string"}}
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": true,
      "description": "每周私聊主人一份用量合计。不写或 enabled 为 false 时不发。",
      "properties": {
        "enabled": {"type": "boolean"},
        "owner_open_ids": {"type": "array", "items": {"type": "string"}},
        "weekday": {"type": ["string", "integer"]},
        "time": {"type": "string"},
        "timezone": {"type": "string"},
        "window_min": {"type": "integer", "minimum": 0}
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "memory": {
          "type": "boolean"
        },
        "p2p": {
          "type": "boolean"
        },
        "tools": {
          "type": "boolean"
        },
        "attachments": {
          "type": "boolean"
        },
        "vision": {
          "type": "boolean"
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "dir": {
          "type": "string"
        },
        "profile_budget_chars": {
          "type": "integer",
          "minimum": 0
        },
        "recall": {
          "type": "boolean"
        },
        "recall_budget_chars": {
          "type": "integer",
          "minimum": 0
        },
        "max_fact_chars": {
          "type": "integer",
          "minimum": 0
        },
        "scope": {
          "type": "string"
        },
        "max_turns": {
          "type": "integer",
          "minimum": 0
        },
        "max_turn_chars": {
          "type": "integer",
          "minimum": 0,
          "description": "记进短期记忆的一条最多多少字，只留开头。不写是 2000。0 表示整段都留。"
        },
        "context_budget_chars": {
          "type": "integer",
          "minimum": 0
        },
        "ttl_hours": {
          "type": "number",
          "minimum": 0
        },
        "per_user": {
          "type": "boolean"
        },
        "trim_note": {
          "type": "boolean",
          "description": "不写或 true：超字数预算丢掉旧对话时，在提示词里注明省略了几条。false 则静默丢掉。"
        },
        "growth": {
          "type": "object",
          "additionalProperties": true,
          "description": "从近期对话提议长期记忆。不写或 enabled 为 false 时不调用模型，也不改账本。",
          "properties": {
            "enabled": {"type": "boolean"},
            "approver_open_ids": {"type": "array", "items": {"type": "string"}},
            "deliver": {"type": "string"},
            "time": {"type": "string"},
            "timezone": {"type": "string"},
            "window_min": {"type": "integer", "minimum": 0},
            "on_schedule": {"type": "boolean"},
            "on_idle": {"type": "boolean"},
            "idle_min": {"type": "integer", "minimum": 0},
            "lookback_hours": {"type": "integer", "minimum": 0},
            "max_messages": {"type": "integer", "minimum": 0},
            "max_proposals": {"type": "integer", "minimum": 0},
            "review_days": {"type": "integer", "minimum": 0},
            "status_days": {"type": "integer", "minimum": 0},
            "deadline_grace_days": {"type": "integer", "minimum": 0},
            "offer_gap_days": {"type": "integer", "minimum": 0},
            "min_confidence": {"type": "number", "minimum": 0},
            "dedupe_ratio": {"type": "number", "minimum": 0},
            "confirm_ttl_sec": {"type": "integer", "minimum": 0},
            "forget_ttl_sec": {"type": "integer", "minimum": 0}
          }
        },
        "retrospect": {
          "type": "object",
          "additionalProperties": true,
          "description": "一轮做完后提议一句短复盘。不写或 enabled 为 false 时不提议，也不改事实。",
          "properties": {
            "enabled": {"type": "boolean"}
          }
        }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "dir": {
          "type": "string"
        },
        "only": {
          "description": "不写、空数组或 false：合法技能全部选用。字符串或字符串数组才收窄目录、预放和 skill_read。创作流程可点名 topic-ideation、short-video-script、storyboard、aigc-prompt-pack、creative-brief、post-mortem。example.json 里仍是空数组。",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "boolean"
            },
            {
              "type": "string"
            }
          ]
        },
        "index_budget_chars": {
          "type": "integer",
          "minimum": 0
        },
        "preload": {
          "type": "boolean"
        },
        "preload_budget_chars": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "p2p": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "allow_open_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_to_all": {
          "type": "boolean"
        },
        "allow_group_members": {
          "type": "boolean",
          "description": "为 true 时，所服务群的当前成员可以私聊。不写或 false 时不查群成员。"
        },
        "member_cache_ttl_sec": {
          "type": "integer",
          "minimum": 0,
          "description": "群成员名单缓存秒数。不写是 600。失败时上次成功的名单最多再沿用两倍。"
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "mode": {
          "type": "string"
        },
        "preset": {
          "type": "string",
          "enum": [
            "",
            "deepseek",
            "dashscope",
            "zhipu",
            "pangu"
          ]
        },
        "model": {
          "type": "string"
        },
        "base_url": {
          "type": "string",
          "pattern": "^$|^https?://\\S+$"
        },
        "api_key_env": {
          "type": "string",
          "pattern": "^$|^[A-Za-z_][A-Za-z0-9_]{0,80}$"
        },
        "network_retries": {
          "type": "integer",
          "minimum": 0
        },
        "max_runtime_sec": {
          "type": "number",
          "minimum": 0
        },
        "stall_sec": {
          "type": "number",
          "minimum": 0
        },
        "max_chars": {
          "type": "integer",
          "minimum": 0
        },
        "body_max_chars": {
          "type": "integer",
          "minimum": 0
        },
        "reply_chunk_chars": {
          "type": "integer",
          "minimum": 0
        },
        "max_tool_rounds": {
          "type": "integer",
          "minimum": 0,
          "description": "只读工具最多连续几轮。不写是 4。小于 1 时按 1。每一轮可以按顺序执行多条只读调用。"
        },
        "tool_context_budget_chars": {
          "type": "integer",
          "minimum": 0,
          "description": "多轮工具结果累积重发的字数预算。不写是 120000。超过时先压缩较早的结果，仍超就截断并注明。0 表示不设预算。"
        },
        "progress_heartbeat_sec": {
          "type": "number",
          "minimum": 0,
          "description": "作答时隔多少秒记进度心跳。不写是 20。0 表示不打这条心跳。"
        }
      }
    },
    "texts": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "redlines": {
          "type": "array"
        }
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": true,
      "description": "分群知识库检索。不写或 enabled 为 false 时不收录、不检索，提示词和命令与以前一样。",
      "properties": {
        "enabled": {"type": "boolean"},
        "auto_retrieve": {"type": "boolean"},
        "local": {"type": "boolean"},
        "group_files": {"type": "boolean"},
        "group_links": {"type": "boolean"},
        "refresh_min": {"type": "integer", "minimum": 0},
        "docs": {"type": "array", "items": {"type": "string"}},
        "wiki": {"type": "array", "items": {"type": "string"}},
        "bases": {"type": "array"},
        "chunk_chars": {"type": "integer", "minimum": 0},
        "chunk_overlap": {"type": "integer", "minimum": 0},
        "top_k": {"type": "integer", "minimum": 0},
        "max_chars": {"type": "integer", "minimum": 0},
        "max_source_chars": {"type": "integer", "minimum": 0},
        "embeddings": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {"type": "boolean"},
            "base_url": {"type": "string"},
            "api_key_env": {"type": "string"},
            "model": {"type": "string"},
            "timeout_sec": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "kb_sync": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "docs_tokens": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "confirm": {
      "type": "object",
      "additionalProperties": true,
      "description": "写入和开关的确认方式。不写时默认点按钮。飞书没开通卡片回调时自动改用确认码。不能写成关掉。",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["button", "code", "button_or_code", "button_and_code"]
        },
        "high_risk_mode": {
          "type": "string",
          "enum": ["button", "code", "button_or_code", "button_and_code"],
          "description": "批量写入、改功能开关、重启这一类。不写时和 mode 相同。"
        },
        "ttl_sec": {
          "type": "integer",
          "minimum": 1,
          "description": "按钮有效秒数。不写是 600。"
        },
        "code_ttl_sec": {
          "type": "integer",
          "minimum": 1,
          "description": "确认码有效秒数。不写时沿用 write.confirm_ttl_sec。"
        },
        "code_digits": {
          "type": "integer",
          "minimum": 4,
          "maximum": 8,
          "description": "确认码位数。不写是 6。"
        }
      }
    },
    "write": {
      "type": "object",
      "additionalProperties": true
    },
    "progress": {
      "type": "object",
      "additionalProperties": true
    },
    "tools": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "history": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "days": {
              "type": "integer",
              "minimum": 0
            },
            "max_pages": {
              "type": "integer",
              "minimum": 0
            },
            "page_size": {
              "type": "integer",
              "minimum": 1,
              "description": "拉群消息时每页条数。不写是 50。停机补答也用这个数。"
            },
            "max_lines": {
              "type": "integer",
              "minimum": 0,
              "description": "交给模型的历史最多几行。不写是 150。超过时注明还剩几行。0 表示不截断。"
            }
          }
        },
        "docs_search": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "max_chars": {
              "type": "integer",
              "minimum": 0,
              "description": "搜索结果最多多少字。不写是 4000。0 表示不截断。"
            }
          }
        },
        "calendar_read": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "max_chars": {
              "type": "integer",
              "minimum": 0,
              "description": "日程结果最多多少字。不写是 4000。0 表示不截断。"
            }
          }
        },
        "base_read": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "max_chars": {
              "type": "integer",
              "minimum": 0,
              "description": "表格结果最多多少字。不写是 5000。0 表示不截断。"
            }
          }
        },
        "message_attachment": {
          "type": "object",
          "additionalProperties": true,
          "description": "读取当前会话里某条历史消息的附件。没写时跟着 attachment.enabled。",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "max_per_answer": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "kb_read": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "max_chars": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "attachment": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "pdf_scan_pages": {
              "type": "integer",
              "minimum": 0,
              "description": "PDF 没有文字时，最多抽出前几页里的内嵌图片。不写是 10。"
            }
          }
        }
      }
    },
    "conflict_pidfiles": {
      "type": "array"
    },
    "shutdown_wait_sec": {
      "type": "number",
      "minimum": 0,
      "description": "停机最多再等几秒。不写是 15。0 表示马上退出。"
    },
    "link_jump_sec": {
      "type": "number",
      "minimum": 0,
      "description": "休眠超过这么多秒就重连长连接。不写是 20。0 表示不因为休眠重连。"
    }
  }
}
